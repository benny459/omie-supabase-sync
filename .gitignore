# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
# Qualquer .env, inclusive sufixados (.env.omie, .env.local...).
# Só ".env" deixava .env.omie exposto a um `git add -A`.
.env
.env.*
!.env.example
*.env

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local secrets (NUNCA comitar)
credentials*.json
*.secret
secrets/

# Obsidian vault — config local não vai pro repo (só os .md)
docs/obsidian/Service/.obsidian/
docs/obsidian/Service/.trash/
docs/obsidian/.DS_Store

# Cópias de conflito do iCloud ("arquivo 2.tsx"). Entraram no repo uma vez via
# `git add -A`; ficam barradas aqui pra não voltarem.
* [0-9].ts
* [0-9].tsx
* [0-9].json

# Tutoriais em vídeo: só o roteiro vai para o git (o mp4 final fica em web/public/manual-video/)
web/tutoriais/*/audio/
web/tutoriais/*/video/
web/tutoriais/*/*.mp4
web/tutoriais/*/marcas.json
web/tutoriais/*/legendas.srt
web/tutoriais/*/partes/
web/tutoriais/*/img/
web/tutoriais/*/img2/
